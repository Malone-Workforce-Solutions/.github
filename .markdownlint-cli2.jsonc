// Lenient markdownlint config for docs repos: style-only rules are off; rules that catch
// broken structure (heading levels, link anchors, unclosed fences) stay on.
{
  "config": {
    "default": true,
    "MD009": false, // trailing spaces
    "MD013": false, // line length
    "MD022": false, // blank lines around headings
    "MD032": false, // blank lines around lists
    "MD033": false, // inline HTML (templates use HTML comments)
    "MD040": false, // language on fenced code blocks
    "MD041": false, // first line must be a top-level heading (PR templates start at ##)
    "MD060": false  // table column alignment
  }
}
